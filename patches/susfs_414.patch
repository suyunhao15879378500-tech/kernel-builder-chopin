+
+/* ---------------------------------------------------------------------
+ * Linux 4.14 compatibility entry points
+ *
+ * v2.4.0 moved try_umount handling into KernelSU. These 4.14 hook sites
+ * still call the in-kernel API, so retain it on the same data structures.
+ * --------------------------------------------------------------------- */
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+static LIST_HEAD(LH_TRY_UMOUNT_PATH);
+static DEFINE_MUTEX(susfs_mutex_lock_try_umount);
+
+void susfs_add_try_umount(void __user **user_info)
+{
+	struct st_susfs_try_umount_list *cursor, *temp, *new_list;
+	struct st_susfs_try_umount info = {0};
+
+	if (copy_from_user(&info, (struct st_susfs_try_umount __user *)*user_info,
+			   sizeof(info))) {
+		info.err = -EFAULT;
+		goto out_copy_to_user;
+	}
+
+	mutex_lock(&susfs_mutex_lock_try_umount);
+	list_for_each_entry_safe(cursor, temp, &LH_TRY_UMOUNT_PATH, list) {
+		if (!strcmp(info.target_pathname, cursor->info.target_pathname)) {
+			info.err = -EEXIST;
+			mutex_unlock(&susfs_mutex_lock_try_umount);
+			goto out_copy_to_user;
+		}
+	}
+
+	new_list = kzalloc(sizeof(*new_list), GFP_KERNEL);
+	if (!new_list) {
+		info.err = -ENOMEM;
+		mutex_unlock(&susfs_mutex_lock_try_umount);
+		goto out_copy_to_user;
+	}
+	memcpy(&new_list->info, &info, sizeof(info));
+	INIT_LIST_HEAD(&new_list->list);
+	list_add_tail(&new_list->list, &LH_TRY_UMOUNT_PATH);
+	mutex_unlock(&susfs_mutex_lock_try_umount);
+	info.err = 0;
+out_copy_to_user:
+	if (copy_to_user(&((struct st_susfs_try_umount __user *)*user_info)->err,
+			 &info.err, sizeof(info.err)))
+		SUSFS_LOGE("failed copying try_umount result to userspace\n");
+}
+
+void susfs_try_umount(uid_t target_uid)
+{
+	struct st_susfs_try_umount_list *cursor;
+
+	/* Reverse order: unmount child mounts before their parents. */
+	list_for_each_entry_reverse(cursor, &LH_TRY_UMOUNT_PATH, list) {
+		if (cursor->info.mnt_mode == TRY_UMOUNT_DEFAULT)
+			ksu_try_umount(cursor->info.target_pathname, false, 0,
+				       target_uid);
+		else if (cursor->info.mnt_mode == TRY_UMOUNT_DETACH)
+			ksu_try_umount(cursor->info.target_pathname, false,
+				       MNT_DETACH, target_uid);
+		else
+			SUSFS_LOGE("unsupported mnt_mode %d for %s\n",
+				   cursor->info.mnt_mode,
+				   cursor->info.target_pathname);
+	}
+}
+
+void susfs_try_umount_all(uid_t uid)
+{
+	susfs_try_umount(uid);
+}
+
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT
+void susfs_auto_add_try_umount_for_bind_mount(struct path *path)
+{
+	struct st_susfs_try_umount_list *cursor, *temp, *new_list;
+	char *pathname, *dpath;
+	bool is_magic_mount_path;
+
+	if (!path || !path->dentry || !path->dentry->d_inode)
+		return;
+	if (path->dentry->d_inode->i_state & INODE_STATE_SUS_KSTAT)
+		return;
+
+	pathname = kmalloc(PAGE_SIZE, GFP_KERNEL);
+	if (!pathname)
+		return;
+	dpath = d_path(path, pathname, PAGE_SIZE);
+	if (IS_ERR(dpath))
+		goto out_free_pathname;
+	is_magic_mount_path = strstr(dpath, MAGIC_MOUNT_WORKDIR) != NULL;
+
+	mutex_lock(&susfs_mutex_lock_try_umount);
+	list_for_each_entry_safe(cursor, temp, &LH_TRY_UMOUNT_PATH, list) {
+		if ((is_magic_mount_path &&
+		     strstr(dpath, cursor->info.target_pathname)) ||
+		    !strcmp(dpath, cursor->info.target_pathname)) {
+			mutex_unlock(&susfs_mutex_lock_try_umount);
+			goto out_free_pathname;
+		}
+	}
+	new_list = kzalloc(sizeof(*new_list), GFP_KERNEL);
+	if (!new_list) {
+		mutex_unlock(&susfs_mutex_lock_try_umount);
+		goto out_free_pathname;
+	}
+	if (is_magic_mount_path)
+		strscpy(new_list->info.target_pathname,
+			dpath + strlen(MAGIC_MOUNT_WORKDIR),
+			SUSFS_MAX_LEN_PATHNAME);
+	else
+		strscpy(new_list->info.target_pathname, dpath,
+			SUSFS_MAX_LEN_PATHNAME);
+	new_list->info.mnt_mode = TRY_UMOUNT_DETACH;
+	INIT_LIST_HEAD(&new_list->list);
+	list_add_tail(&new_list->list, &LH_TRY_UMOUNT_PATH);
+	mutex_unlock(&susfs_mutex_lock_try_umount);
+out_free_pathname:
+	kfree(pathname);
+}
+#endif
+#endif /* CONFIG_KSU_SUSFS_TRY_UMOUNT */
+
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT
+int susfs_auto_add_sus_bind_mount(const char *pathname,
+				  struct path *path_target)
+{
+	struct mount *mnt = real_mount(path_target->mnt);
+	struct inode *inode;
+
+	/* A legitimate peer group is not a SUSFS-created mount. */
+	if (mnt->mnt_group_id > 0 &&
+	    mnt->mnt_group_id < DEFAULT_SUS_MNT_GROUP_ID)
+		return 0;
+	inode = d_backing_inode(path_target->dentry);
+	if (!inode)
+		return 1;
+	if (!(inode->i_state & INODE_STATE_SUS_MOUNT)) {
+		spin_lock(&inode->i_lock);
+		inode->i_state |= INODE_STATE_SUS_MOUNT;
+		spin_unlock(&inode->i_lock);
+	}
+	return 0;
+}
+#endif
+
+#ifdef CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT
+void susfs_auto_add_sus_ksu_default_mount(const char __user *to_pathname)
+{
+	char *pathname;
+	struct path path;
+	struct inode *inode;
+
+	pathname = kmalloc(SUSFS_MAX_LEN_PATHNAME, GFP_KERNEL);
+	if (!pathname)
+		return;
+	if (strncpy_from_user(pathname, to_pathname,
+			      SUSFS_MAX_LEN_PATHNAME - 1) < 0)
+		goto out_free_pathname;
+	pathname[SUSFS_MAX_LEN_PATHNAME - 1] = '\0';
+	if ((!strncmp(pathname, "/data/adb/modules", 17) ||
+	     !strncmp(pathname, "/debug_ramdisk", 14) ||
+	     !strncmp(pathname, "/system", 7) ||
+	     !strncmp(pathname, "/system_ext", 11) ||
+	     !strncmp(pathname, "/vendor", 7) ||
+	     !strncmp(pathname, "/product", 8) ||
+	     !strncmp(pathname, "/odm", 4)) &&
+	    !kern_path(pathname, LOOKUP_FOLLOW, &path)) {
+		inode = d_backing_inode(path.dentry);
+		if (inode && !(inode->i_state & INODE_STATE_SUS_MOUNT)) {
+			spin_lock(&inode->i_lock);
+			inode->i_state |= INODE_STATE_SUS_MOUNT;
+			spin_unlock(&inode->i_lock);
+		}
+		path_put(&path);
+	}
+out_free_pathname:
+	kfree(pathname);
+}
+#endif
+#endif /* CONFIG_KSU_SUSFS_SUS_MOUNT */
